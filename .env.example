# ==========================================================
#  Variables de entorno del FRONTEND (Vite)
#  Copia este archivo como ".env" y completa los valores.
#  En Vite, TODAS las variables expuestas al navegador deben
#  empezar con VITE_  (no pongas aquí secretos del backend).
# ==========================================================

# URL base del backend (SIN /api/v1 al final, eso lo agrega el código)
VITE_API_URL=https://fundaciontcs.columbus.edu.co

# Llave PÚBLICA de Wompi (producción). Empieza con pub_prod_
# La pública sí puede ir en el frontend; la privada NO.
VITE_PUBLISHABLE_KEY=pub_prod_izvHROR3Ab3vRDitqXbgO37bnkWDzhqO

# URL de la API de Wompi.
# PRODUCCIÓN -> https://api.wompi.co/v1
# SANDBOX    -> https://sandbox.wompi.co/v1
# ⚠️ En producción DEBE ser api.wompi.co/v1, si no el pago recurrente falla.
VITE_WOMPI_URL=https://api.wompi.co/v1
